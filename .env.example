# Copy this to .env and fill in your values. .env is gitignored.

# Required: API key for your LLM provider
KALLE_API_KEY=

# Optional overrides (these are the built-in defaults; override via env var or
# by creating a kalle.yaml in your working directory)
# KALLE_BASE_URL=https://ollama.com/v1
# KALLE_FAST_MODEL=deepseek-v4.1-flash:cloud
# KALLE_STRONG_MODEL=kimi-k2.6:cloud

# Required only for --math
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
